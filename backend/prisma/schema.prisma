generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  USUARIO
  ADMIN
  SUPER_ADMIN
}

model Usuario {
  id           Int         @id @default(autoincrement())
  nome         String
  email        String      @unique
  senha        String
  perfil       Perfil      @default(USUARIO)
  ativo        Boolean     @default(true)
  criadoEm     DateTime    @default(now())
  atualizadoEm DateTime    @updatedAt

  auditorias   Auditoria[] @relation("AcoesUsuario")

  @@map("usuarios")
}

model Auditoria {
  id           Int      @id @default(autoincrement())
  acao         String   
  entidade     String   
  entidadeId   String   
  mudancas     Json?    
  realizadoPor Int   
  criadoEm     DateTime @default(now())

  admin        Usuario  @relation("AcoesUsuario", fields: [realizadoPor], references: [id])

  @@map("auditorias")
}

// ==========================================
// NOVAS ENTIDADES (FORMULÁRIOS & CRUDs)
// ==========================================

model InscricaoCurso {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String
  telefone     String?
  curso        String
  mensagem     String?
  status       String   @default("PENDENTE") // PENDENTE, APROVADO, REJEITADO
  criadoEm     DateTime @default(now())

  @@map("inscricoes_cursos")
}

model SolicitacaoConsultoria {
  id           Int      @id @default(autoincrement())
  nomeEmpresa  String
  nomeContato  String
  email        String
  telefone     String?
  necessidade  String
  status       String   @default("NOVO") // NOVO, EM_ANDAMENTO, CONCLUIDO
  criadoEm     DateTime @default(now())

  @@map("solicitacoes_consultoria")
}

model PerfilParceiro {
  id           Int      @id @default(autoincrement())
  nomeEmpresa  String
  email        String
  setor        String
  proposta     String
  status       String   @default("ANALISE") // ANALISE, APROVADO, RECUSADO
  criadoEm     DateTime @default(now())

  @@map("perfis_parceiros")
}

model Oportunidade {
  id           Int      @id @default(autoincrement())
  titulo       String
  descricao    String
  requisitos   String
  ativa        Boolean  @default(true)
  criadoEm     DateTime @default(now())

  @@map("oportunidades")
}

model Banner {
  id           Int      @id @default(autoincrement())
  titulo       String
  tituloDestaque String?
  descricao    String?
  imagemUrl    String
  linkDestino  String?
  ordem        Int      @default(0)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("banners")
}

model Servico {
  id           Int      @id @default(autoincrement())
  titulo       String
  area         String?  @default("Outras Áreas")
  descricao    String
  iconeUrl     String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("servicos")
}

model Newsletter {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())

  @@map("newsletters")
}

model Curso {
  id              Int      @id @default(autoincrement())
  titulo          String
  categoria       String
  descricao       String
  cargaHoraria    String
  modalidade      String
  certificadora   String
  imagemUrl       String
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  @@map("cursos")
}

model ParceiroInstitucional {
  id           Int      @id @default(autoincrement())
  nome         String
  categoria    String   @default("Universidades & Academia")
  tags         String?  // Ex: "Cursos, Investigação"
  descricao    String
  imagemUrl    String?
  ativo        Boolean  @default(true)
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("parceiros_institucionais")
}

model Publicacao {
  id             Int                   @id @default(autoincrement())
  titulo         String
  slug           String                @unique
  resumo         String
  conteudo       String
  imagemCapaUrl  String?
  categoria      String
  autor          String?
  tags           String?
  status         String                @default("RASCUNHO") // RASCUNHO, AGENDADO, PUBLICADO, ARQUIVADO
  publicadoEm    DateTime?
  agendadoPara   DateTime?
  seoTitulo      String?
  seoDescricao   String?
  criadoEm       DateTime              @default(now())
  atualizadoEm   DateTime              @updatedAt
  documentos     DocumentoPublicacao[]
  visualizacoes  VisualizacaoPublicacao[]
  downloads      DownloadPublicacao[]

  @@index([status, publicadoEm])
  @@index([categoria])
  @@map("publicacoes")
}

model DocumentoPublicacao {
  id            Int        @id @default(autoincrement())
  publicacaoId  Int
  nomeArquivo   String
  arquivoUrl    String
  mimeType      String
  tamanhoBytes  Int
  versao        Int        @default(1)
  criadoEm      DateTime   @default(now())
  atualizadoEm  DateTime   @updatedAt
  publicacao    Publicacao @relation(fields: [publicacaoId], references: [id], onDelete: Cascade)
  downloads     DownloadPublicacao[]

  @@index([publicacaoId])
  @@map("documentos_publicacoes")
}

model VisualizacaoPublicacao {
  id            Int        @id @default(autoincrement())
  publicacaoId  Int
  visitanteHash String
  origem        String?
  criadoEm      DateTime   @default(now())
  publicacao    Publicacao @relation(fields: [publicacaoId], references: [id], onDelete: Cascade)

  @@index([publicacaoId, criadoEm])
  @@index([visitanteHash, criadoEm])
  @@map("visualizacoes_publicacoes")
}

model DownloadPublicacao {
  id            Int                  @id @default(autoincrement())
  publicacaoId  Int
  documentoId   Int
  visitanteHash String
  criadoEm      DateTime             @default(now())
  publicacao    Publicacao           @relation(fields: [publicacaoId], references: [id], onDelete: Cascade)
  documento     DocumentoPublicacao  @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@index([publicacaoId, criadoEm])
  @@index([documentoId])
  @@map("downloads_publicacoes")
}

