{
  "name": "blue-axis-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend BLUE HORIZON — servidor Node e página inicial",
  "main": "server.js",
  "scripts": {
    "start": "npm run build:css && node server.js",
    "dev": "node scripts/dev.js",
    "build:css": "tailwindcss -i ./src/css/input.css -o ./public/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/css/input.css -o ./public/css/tailwind.css --watch"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "tailwindcss": "^3.4.19"
  }
}
